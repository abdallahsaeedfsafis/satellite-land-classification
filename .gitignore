# ==== Data ====
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.tar
*.tar.gz
*.zip

# ==== Python ====
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
env/
*.egg-info/

# ==== Model outputs (heavy files) ====
outputs/models/*.pt
outputs/models/*.h5
outputs/models/*.keras
!outputs/models/.gitkeep

# ==== OS / Editor ====
.DS_Store
.vscode/
*.log

# ==== Model outputs (heavy files) ====
# CNN models are small enough to commit (~4.5MB each) and are needed for the
# deployed Streamlit app. ViT models are excluded due to their large size (~330MB).
outputs/models/vit_pytorch.pt
outputs/models/vit_keras/
!outputs/models/.gitkeep